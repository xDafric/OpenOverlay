    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.17.2",
    "superjson": "^2.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.1",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "plop": "^4.0.5",
