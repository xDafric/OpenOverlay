  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "server:dev": "tsx watch src/index.ts",
    "dev": "concurrently --names server,studio \"npm run server:dev\" \"npm run studio\"",
    "drizzle:gen": "drizzle-kit generate",
    "drizzle:drop": "drizzle-kit drop",
    "drizzle:migrate": "drizzle-kit migrate",
    "betterAuth:generate": "npx @better-auth/cli generate --output src/modules/auth/auth.schema.ts --config src/betterAuth/auth.ts",
    "plop:module": "plop Model",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "^1.4.17",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
